# Copiar este archivo como ".env" y completar los valores.
# El .env no se sube al repositorio (esta en .gitignore) porque tiene datos sensibles.

NODE_ENV=<NODE_ENV>
PORT=<PORT>

# Base de datos MySQL/MariaDB
DB_HOST=<DB_HOST>
DB_PORT=<DB_PORT>
DB_NAME=<DB_NAME>
DB_USER=<DB_USER>
DB_PASSWORD=<DB_PASSWORD>
DB_SSL=<DB_SSL>
DB_SSL_REJECT_UNAUTHORIZED=<DB_SSL_REJECT_UNAUTHORIZED>
DB_SSL_CA=<DB_SSL_CA>
DB_SYNCHRONIZE=<DB_SYNCHRONIZE>

# Clave para firmar la cookie de sesion. Usar un valor largo, aleatorio y privado.
SESSION_SECRET=<SESSION_SECRET>

# Origen permitido para CORS (donde corre el frontend Vue en desarrollo)
FRONTEND_URL=<FRONTEND_URL>

# Alicuota de IVA que se usa para discriminar el impuesto de los precios finales
IVA=<IVA>

# Credenciales SMTP para el envio de mails (recuperacion de password, etc).
# Completar con los datos del proveedor de correo (Gmail, SendGrid, etc).
# Si se dejan vacias, la app arranca igual pero solo loguea los mails en
# vez de enviarlos.
SMTP_HOST=<SMTP_HOST>
SMTP_PORT=<SMTP_PORT>
SMTP_SECURE=<SMTP_SECURE>
SMTP_USER=<SMTP_USER>
SMTP_PASSWORD=<SMTP_PASSWORD>
SMTP_FROM=<SMTP_FROM>
