# Copiar este archivo como ".env" y completar los valores.
# En Render, estas variables se configuran en el build del sitio estatico
# del frontend (Environment > Environment Variables), no en un .env commiteado.

# URL base de la API del backend. En desarrollo, si se deja vacia, usa "/api"
# (proxy de Vite). En produccion (frontend y backend en distinto origen) debe
# apuntar al backend, ej: https://vmcshop.onrender.com/api
VITE_API_URL=

# URL base donde el backend sirve las imagenes subidas (/uploads/...). Sin
# esto en produccion, las imagenes subidas desde el admin (productos,
# categorias, marcas, banners) no se resuelven y se muestran las demos.
VITE_UPLOADS_URL=https://vmcshop.onrender.com/uploads
